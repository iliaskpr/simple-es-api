# Elasticsearch URL
ES_HOST=https://localhost:9200

# Auth method: "api_key" or "basic"
ES_AUTH_METHOD=api_key

# Used when ES_AUTH_METHOD=api_key (base64 encoded "id:api_key")
ES_API_KEY=

# Used when ES_AUTH_METHOD=basic
ES_USERNAME=
ES_PASSWORD=

# Set to true to skip the SSL certificate check (custom CA setups)
ES_IGNORE_SSL=false

# Max number of queries sent to Elasticsearch at the same time
ES_MAX_CONNECTIONS=10

# Max time for one query, in seconds
QUERY_TIMEOUT=300

# SQLite file for the request log
DB_PATH=requests.db

# Set to true to store the query body in the request log
LOG_QUERY=false
